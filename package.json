{
  "name": "jlpt-n5",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/prepare-content.js",
    "content:check": "node scripts/prepare-content.js --check",
    "build:static": "node scripts/build-static.js",
    "voices": "node scripts/generate-voices.js",
    "generate": "npm run content && npm run voices",
    "start": "node scripts/serve.js",
    "test": "npm run content:check && node --test tests/learning-stats.test.js tests/settings.test.js tests/static-app.test.js",
    "test:voices": "node --test tests/voices.test.js"
  },
  "devDependencies": {
    "lindera-wasm-ipadic-nodejs": "2.3.4"
  }
}
